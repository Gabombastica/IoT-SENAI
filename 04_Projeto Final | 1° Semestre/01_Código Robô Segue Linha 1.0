from machine import Pin, PWM, ADC
import time
from hcsr04 import HCSR04
from time import sleep

in1 = Pin(18, Pin.OUT)
in2 = Pin(5, Pin.OUT)
in3 = Pin(17, Pin.OUT)
in4 = Pin(16, Pin.OUT)
ena = PWM(Pin(19), 800)
enb = PWM(Pin(4), 800)

TRIG = Pin(13)
ECHO = Pin(12)
ultrasonico = HCSR04(trigger_pin=TRIG, echo_pin=ECHO)

# Informações dos sensores do TCRT5000
sensor1 = ADC(Pin(15)) # Sensor do lado direito
sensor1.atten(ADC.ATTN_11DB)
sensor1.width(ADC.WIDTH_12BIT)
sensor2 = ADC(Pin(2)) # Sensor do lado esquerdo
sensor2.atten(ADC.ATTN_11DB)
sensor2.width(ADC.WIDTH_12BIT)
vel1 = 500
vel2 = 400

def tras_motor1(velocidade):
    in1.value(1)# Ligando para indicar o sentido do movimento do motor 1, a velocidade sera alterada conforme o adequado.
    in2.value(0)# Desligado, pois indica o outro sentido (para trás).
    ena.duty(velocidade)# O "u16" indica o máximo e mínimo de velocidade, nesse caso de 0 a 65535.
   
def tras_motor2(velocidade):
    in3.value(1)# Ligando para indicar o sentido do movimento do motor 1, a velocidade sera alterada conforme o adequado.
    in4.value(0)# Desligado pois indica o outro sentido (para trás).
    enb.duty(velocidade)# O "u16" indica o máximo e mínimo de velocidade, nesse caso de 0 a 65535.
   
def frente_motor1(velocidade):
    in1.value(0)
    in2.value(1)
    ena.duty(velocidade)
   
def frente_motor2(velocidade):
    in3.value(0)
    in4.value(1)
    enb.duty(velocidade)
   
def parar_motor1():
    in1.value(0)
    in2.value(0)
    ena.duty(0)
   
def parar_motor2():
    in3.value(0)
    in4.value(0)
    enb.duty(0)
   
def virar_esquerda(velocidade):
    tras_motor2(400)
    parar_motor1()
    ena.duty(velocidade)
    enb.duty(velocidade)
   
def virar_direita(velocidade):
    frente_motor1(400)
    parar_motor2()
    ena.duty(velocidade)
    enb.duty(velocidade)
   
def girar_no_eixo_para_direita():
    frente_motor1(300)
    tras_motor2(300)
    sleep(0.04)
    frente_motor1(300)
    tras_motor2(300)
    sleep(0.04)
    parar_motor1()
    parar_motor2()
    sleep(0.04)
    frente_motor1(400)
    frente_motor2(400)
    sleep(0.04)
    frente_motor1(200)
    frente_motor2(200)
    sleep(0.04)

def girar_no_eixo_para_esquerda():
    frente_motor1(300)
    tras_motor2(300)
    sleep(0.04)
    parar_motor1()
    parar_motor2()
    sleep(0.04)
    tras_motor1(400)
    tras_motor2(400)
    sleep(0.04)
    tras_motor1(200)
    tras_motor2(200)
    sleep(0.04)

primeiro = 0
msg = ""
try:
    while 0:
        ler1 = sensor1.read()
        ler2 = sensor2.read()
        print(f"1 = {ler1}  2 = {ler2}")
        sleep(0.1)
       
    while 0:
        #frente_motor1(290)
        #frente_motor2(300)
        tras_motor2(300)
        sleep(0.1)

    while 0:
        ler1 = sensor1.read()
        ler2 = sensor2.read()
        if ler1 < 1000 and ler2 < 1000 and ler1 > 70 and ler2 > 70:
            frente_motor1(vel2)
            frente_motor2(vel2)
            sleep(0.1)
            frente_motor1(vel1)
            frente_motor2(vel1)
        else:
            while ler1 > 1000 or ler2 > 1000:
                frente_motor1(vel2)
                tras_motor2(vel2)
                sleep(0.1)
                frente_motor1(vel1)
                tras_motor2(vel1)
                
    while 1:
        """
        s1 preto < 60 preto
        s2 preto
        """
        ler1 = sensor1.read()
        ler2 = sensor2.read()
        print(f"{msg} ||1 = {ler1} |2 = {ler2}")
        sleep(0.2)
        if ler1 < 300 and ler2 < 300:
            frente_motor1(0)
            frente_motor2(0)
            msg = "Branco"
            sleep(0.1)
        elif ler1 > 1000 and ler2 > 1000:
            frente_motor1(0)
            frente_motor2(0)
            msg = "Preto"
            sleep(0.1)
        elif ler1 < 1000 and ler2 < 1000:
            frente_motor1(vel1)
            frente_motor2(vel1)
            msg = "Linha"
            sleep(0.1)
        elif ler1 < 300 and ler2 > 1000:
            frente_motor1(vel2)
            frente_motor2(vel2)
            sleep(0.01)
            frente_motor1(vel1)
            frente_motor2(vel1)
            sleep(0.1)
            tras_motor1(vel2)
            parar_motor2()
            sleep(0.01)
            tras_motor1(vel1)
            parar_motor2()
        elif ler2 < 300 and ler1 > 1000:
            frente_motor1(vel2)
            frente_motor2(vel2)
            sleep(0.01)
            frente_motor1(vel1)
            frente_motor2(vel1)
            sleep(0.1)
            tras_motor2(vel2)
            parar_motor1()
            sleep(0.01)
            tras_motor2(vel2)
            parar_motor1()
            sleep(0.1)
        else:
            msg = "Leitura Error"
            sleep(0.1)
            
    while 0:
        ler1 = sensor1.read()
        ler2 = sensor2.read()
        print(f"1 = {ler1}")
        print(f"2 = {ler2}")
        sleep(0.1)
        if ler1 < 60 and ler2 < 60:
            frente_motor1(400)
            frente_motor2(400)
            sleep(0.03)
            frente_motor1(10)
            frente_motor2(10)
        elif ler2 >= 70:
            tras_motor1(200)
            tras_motor2(200)
            sleep(0.01)
            tras_motor1(50)
            tras_motor2(50)
            sleep(0.05)
            girar_no_eixo_para_esquerda()
        elif ler1 >= 70:
            tras_motor1(200)
            tras_motor2(200)
            sleep(0.01)
            tras_motor1(50)
            tras_motor2(50)
            sleep(0.03)
            girar_no_eixo_para_direita()
           
    while 0 :
        var_cm = ultrasonico.distance_cm()
        print(var_cm)
        sleep(0.1)
        if var_cm <= 20:
            parar_motor1()
            parar_motor2()
        else:
            frente_motor1(25000)
            tras_motor2(25000)
            sleep(0.2)
            frente_motor1(10000)
            tras_motor2(10000)
    while 0:
        var_cm = ultrasonico.distance_cm()
        print(var_cm)
        sleep(0.1)
        if var_cm <= 23:
            frente_motor1(25000)
            tras_motor2(25000)
            sleep(0.15)
            parar_motor1()
            parar_motor2()
            sleep(0.5)
            virar_direita(10000)
            virar_esquerda(5000)
            sleep(0.5)
            frente_motor1(10000)
            tras_motor2(10000)
        else:
            frente_motor1(25000)
            tras_motor2(25000)
            sleep(0.2)
            frente_motor1(10000)
            tras_motor2(10000)

finally:
    parar_motor1()
    parar_motor2()
